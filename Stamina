Dưới đây là script của bạn đã được chỉnh sửa và cấu trúc lại toàn bộ hệ thống UI theo chính xác các thông số bạn yêu cầu (bao gồm 3 Frame: `HC_Sprintbar`, `Bar` nền, `Bar` chạy stamina, các `UIPadding`, `UICorner`, `UIStroke`, cũng như bo góc tròn cho `SprintButton`).

```lua
-- Create the ScreenGui and Sprint Bar
local player = game.Players.LocalPlayer
local screenGui = Instance.new("ScreenGui")
screenGui.IgnoreGuiInset = true
screenGui.Parent = player.PlayerGui

--------------------------------------------------------
-- NEW STAMINA UI STRUCTURE (3 FRAMES)
--------------------------------------------------------

-- 1. Frame chính: HC_Sprintbar
local HC_Sprintbar = Instance.new("Frame")
HC_Sprintbar.Name = "HC_Sprintbar"
HC_Sprintbar.Size = UDim2.new(0.34, 20, 0.05, 10)
HC_Sprintbar.Position = UDim2.new(0, 10, 1, 5) -- Lưu ý: Y = 1 và offset = 5 có thể đẩy UI xuống dưới rìa màn hình một chút nếu không có thiết lập khác, mình giữ đúng theo yêu cầu của bạn nhé.
HC_Sprintbar.AnchorPoint = Vector2.new(0, 1)
HC_Sprintbar.SizeConstraint = Enum.SizeConstraint.RelativeXY
HC_Sprintbar.ZIndex = 1005
HC_Sprintbar.BackgroundTransparency = 1 -- Ẩn frame chính để lộ frame con bên trong
HC_Sprintbar.Parent = screenGui

-- UIPadding cho HC_Sprintbar
local hcPadding = Instance.new("UIPadding")
hcPadding.PaddingBottom = UDim.new(0.3, -5)
hcPadding.PaddingLeft = UDim.new(0.1, 0)
hcPadding.PaddingRight = UDim.new(0.1, 0)
hcPadding.PaddingTop = UDim.new(0.3, -5)
hcPadding.Parent = HC_Sprintbar

-- 2. Frame thứ hai: Bar (Làm nền phía sau)
local outerBar = Instance.new("Frame")
outerBar.Name = "Bar"
outerBar.BackgroundColor3 = Color3.fromRGB(71, 88, 185)
outerBar.BorderColor3 = Color3.fromRGB(27, 42, 53)
outerBar.Position = UDim2.new(0.5, 0, 0.5, 0)
outerBar.Size = UDim2.new(1, 0, 0.35, 0)
outerBar.BackgroundTransparency = 0.7
outerBar.AnchorPoint = Vector2.new(0.5, 0.5)
outerBar.Parent = HC_Sprintbar

-- Các thành phần bên trong Frame Bar nền
local outerCorner = Instance.new("UICorner")
outerCorner.CornerRadius = UDim.new(0.25, 0)
outerCorner.Parent = outerBar

local outerPadding = Instance.new("UIPadding")
outerPadding.PaddingLeft = UDim.new(0, 3)
outerPadding.PaddingRight = UDim.new(0, 3)
outerPadding.PaddingTop = UDim.new(0, 3)
outerPadding.PaddingBottom = UDim.new(0, 3)
outerPadding.Parent = outerBar

local outerStroke = Instance.new("UIStroke")
outerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
outerStroke.Color = Color3.fromRGB(71, 88, 185)
outerStroke.Thickness = 4
outerStroke.Parent = outerBar

-- 3. Frame thứ ba: Bar (Thanh chạy hiển thị Stamina thực tế)
local sprintBar = Instance.new("Frame")
sprintBar.Name = "Bar"
sprintBar.Size = UDim2.new(1, 0, 1, 0)
sprintBar.Position = UDim2.new(0, 0, 0.5, 0)
sprintBar.BackgroundColor3 = Color3.fromRGB(71, 88, 185)
sprintBar.AnchorPoint = Vector2.new(0, 0.5)
sprintBar.Parent = outerBar

-- UICorner cho thanh chạy
local innerCorner = Instance.new("UICorner")
innerCorner.CornerRadius = UDim.new(0.25, 0)
innerCorner.Parent = sprintBar

--------------------------------------------------------
-- DARK SCREEN EFFECT WHEN LOW STAMINA
--------------------------------------------------------

local darkScreen = Instance.new("Frame")
darkScreen.Size = UDim2.new(1, 0, 1, 0)
darkScreen.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
darkScreen.BackgroundTransparency = 1
darkScreen.Parent = screenGui

--------------------------------------------------------
-- STAMINA SYSTEM LOGIC
--------------------------------------------------------

local sprinting = false
local maxStamina = 100
local currentStamina = maxStamina
local staminaRegenRate = 20
local staminaDrainRate = 18
local canSprint = true

local sprintSpeed = 20
local walkSpeed = 15

local humanoid = player.Character:WaitForChild("Humanoid")

local function updateSprintBar()
	-- Thay đổi chiều rộng dựa trên lượng stamina hiện tại
	sprintBar.Size = UDim2.new(currentStamina / maxStamina, 0, 1, 0)
end

local function updateDarkScreen()
	if currentStamina < 100 then
		local percent = math.clamp(1 - (currentStamina / 70), 0, 1)
		darkScreen.BackgroundTransparency = 1 - (percent * 0.4)
	else
		darkScreen.BackgroundTransparency = 1
	end
end

--------------------------------------------------------
-- SPRINT BUTTON WITH UICORNER
--------------------------------------------------------

local sprintButton = Instance.new("TextButton")
sprintButton.Size = UDim2.new(0.083, 0, 0.115, 0)
sprintButton.Position = UDim2.new(0.916, 0, 0.369, 0)
sprintButton.Text = "Sprint"
sprintButton.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
sprintButton.TextColor3 = Color3.fromRGB(255, 255, 255)
sprintButton.Parent = screenGui

-- Thêm UICorner cho SprintButton theo yêu cầu (CornerRadius = 1, 0 giúp nút bo tròn hoàn toàn)
local buttonCorner = Instance.new("UICorner")
buttonCorner.CornerRadius = UDim.new(1, 0)
buttonCorner.Parent = sprintButton

--------------------------------------------------------
-- BUTTON TOGGLE
--------------------------------------------------------

sprintButton.MouseButton1Click:Connect(function()
	if canSprint and currentStamina > 0 then
		sprinting = not sprinting

		if sprinting then
			humanoid.WalkSpeed = sprintSpeed
		else
			humanoid.WalkSpeed = walkSpeed
		end
	end
end)

--------------------------------------------------------
-- HEARTBEAT LOOP
--------------------------------------------------------

local runService = game:GetService("RunService")

runService.Heartbeat:Connect(function(dt)
	if sprinting then
		if currentStamina > 0 then
			currentStamina -= staminaDrainRate * dt
		else
			sprinting = false
			canSprint = false -- Không cho sprint nữa
			humanoid.WalkSpeed = walkSpeed

			require(player.PlayerGui.MainUI.Initiator.Main_Game).caption("You're exhausted", true)
		end
	else
		if currentStamina < maxStamina then
			currentStamina += staminaRegenRate * dt
		end
	end

	-- Khi hồi full → được sprint lại
	if currentStamina >= maxStamina then
		canSprint = true
	end

	currentStamina = math.clamp(currentStamina, 0, maxStamina)

	updateSprintBar()
	updateDarkScreen()
end)

```
