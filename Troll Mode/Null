entity:SetCallback("OnSpawned", function()
	print("Entity has spawned")
	-- Bọc vào task.spawn để vòng lặp này không làm nghẽn toàn bộ script bên dưới của bạn
	thraed = task.spawn(function()
		local SPEED_STUDS_PER_SECOND = 400
		local MOVE_DURATION = 0.06 -- Thời gian di chuyển (0.1 giây)
		local COOLDOWN_DURATION = 2 -- Thời gian đứng im chờ (2 giây)

		while true do
			local model = workspace:WaitForChild("Null", 5)
			if not model then task.wait(1) continue end

			local part = model:FindFirstChild("Part") or model:FindFirstChildWhichIsA("BasePart")
			if not part then task.wait(1) continue end

			local chr = player.Character
			local hrp = chr and chr:FindFirstChild("HumanoidRootPart")

			-- Nếu người chơi chết hoặc chưa tải xong nhân vật, đứng im đợi
			if not hrp then 
				task.wait(1) 
				continue 
			end

			part.Anchored = true

			-- 1. Tính toán hướng và khoảng cách tới người chơi tại thời điểm hiện tại
			local startPos = part.Position
			local targetPos = hrp.Position
			local distance = (targetPos - startPos).Magnitude

			if distance > 1 then -- Chỉ di chuyển nếu ở xa player
				local direction = (targetPos - startPos).Unit

				-- Tính quãng đường tối đa đi được trong 0.1 giây (400 * 0.1 = 40 studs)
				local stepDistance = SPEED_STUDS_PER_SECOND * MOVE_DURATION

				-- Nếu khoảng cách tới player gần hơn bước nhảy, chỉ đi tới vị trí player
				if distance < stepDistance then
					stepDistance = distance
				end

				-- 2. Xác định tọa độ CFrame đích của bước nhảy này (Xoay mặt về hướng player)
				local nextPosition = startPos + (direction * stepDistance)
				local nextCFrame = CFrame.lookAt(nextPosition, Vector3.new(targetPos.X, nextPosition.Y, targetPos.Z))

				-- 3. Thực hiện bước lướt đi trong đúng 0.1 giây
				local tween = TweenService:Create(
					part,
					TweenInfo.new(MOVE_DURATION, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
					{CFrame = nextCFrame}
				)

				tween:Play()
				tween.Completed:Wait() -- Chờ đi hết 0.1 giây
			end

			-- 4. Dừng lại hoàn toàn trong 2 giây trước khi tiếp tục chu kỳ mới
			task.wait(COOLDOWN_DURATION)
		end
	end)
	wait(60)
	if thraed then
		task.cancel(thraed)
		thraed = nil
	end
	entity:Destroy()
end)

