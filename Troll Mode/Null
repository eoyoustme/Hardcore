task.spawn(function()

			local Players = game:GetService("Players")
			local RunService = game:GetService("RunService")
			local localPlayer = Players.LocalPlayer

			if not localPlayer then return end

			local random = math.random
			local colorRGB = Color3.fromRGB
			local vector3New = Vector3.new

			-- [CẤU HÌNH HIỆU ỨNG]
			local MAX_DISTANCE = 150        -- Khoảng cách quét xung quanh Player (studs)
			local GLITCH_INTENSITY = 3.5      -- Cường độ giật xé hình (Tăng lên nếu muốn nát hình hơn)
			local startTime = os.clock()

			-- [BẢNG LƯU TRỮ HỆ THỐNG]
			local visualClones = {}         -- Lưu trữ dữ liệu bản sao ảo
			local targetParts = {}

			setmetatable(visualClones, {__mode = "k"}) -- Tự giải phóng bộ nhớ tránh lag RAM

			-- [TỰ ĐỘNG TẠO UI FRAME NHẤP NHÁY]
			local playerGui = localPlayer:WaitForChild("PlayerGui")
			local screenGui = playerGui:FindFirstChild("GlitchGui") or Instance.new("ScreenGui")
