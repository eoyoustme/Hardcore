local function StartMonochromeTint(isRed)
	tintCounter = tintCounter + 1
	if tintTween then tintTween:Cancel() tintTween = nil end

	SilenceMonochromeTint.Enabled = true
	SilenceMonochromeTint.TintColor = isRed and Color3.fromRGB(255, 110, 110) or Color3.fromRGB(255, 255, 255)

	local t1 = TweenService:Create(SilenceMonochromeTint, TweenInfo.new(0.01, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		Saturation = 0.2, Contrast = 0.15, Brightness = 0.25
	})
	t1:Play()
	t1.Completed:Wait()

	tintTween = TweenService:Create(SilenceMonochromeTint, TweenInfo.new(5, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
		Saturation = -1, Contrast = 0.15, Brightness = -0.05
	})
	tintTween:Play()
end

local function StopMonochromeTint()
	tintCounter = tintCounter + 1
	if tintTween then tintTween:Cancel() tintTween = nil end

	SilenceMonochromeTint.Saturation = 0
	SilenceMonochromeTint.Contrast = 0
	SilenceMonochromeTint.Brightness = 0
	SilenceMonochromeTint.TintColor = Color3.fromRGB(255, 255, 255)
	SilenceMonochromeTint.Enabled = false
end

local function StartText(duration)
	textCounter = textCounter + 1
	if shakeConnection then shakeConnection:Disconnect() shakeConnection = nil end
	for _, tw in ipairs(activeTweens) do tw:Cancel() end
	table.clear(activeTweens)

	HeardText.Visible = true
	HeardText.Position = defaultTextPos
	HeardText.Rotation = 0
	HeardText.TextTransparency = 0.8
	HeardText.TextStrokeTransparency = 0.8
	HeardText.TextColor3 = Color3.fromRGB(255, 255, 255)

	local startTime = os.clock()
	local currentId = textCounter

	shakeConnection = RunService.RenderStepped:Connect(function()
		if currentId == textCounter then
			local progress = math.clamp((os.clock() - startTime) / math.max(duration, 0.01), 0, 1)
			local shakeX = progress ^ 2 * 32 + 2
			local shakeRot = progress ^ 2 * 10 + 1

			HeardText.Position = UDim2.new(
				defaultTextPos.X.Scale, defaultTextPos.X.Offset + math.random(-math.floor(shakeX), math.floor(shakeX)),
				defaultTextPos.Y.Scale, defaultTextPos.Y.Offset + math.random(-math.floor(shakeX), math.floor(shakeX))
			)
			HeardText.Rotation = math.random(-math.floor(shakeRot), math.floor(shakeRot))
		end
	end)
end

local function LaunchText(isRed)
	textCounter = textCounter + 1
	local currentId = textCounter

	if shakeConnection then shakeConnection:Disconnect() shakeConnection = nil end
	for _, tw in ipairs(activeTweens) do tw:Cancel() end
	table.clear(activeTweens)

	if not HeardText.Visible then return end

	HeardText.Position = defaultTextPos
	HeardText.Rotation = 0
	HeardText.TextColor3 = Color3.fromRGB(255, 255, 255)

	local rotDir = if math.random(1, 2) == 1 then -360 else 360
	local tw1 = TweenService:Create(HeardText, TweenInfo.new(0.25, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
		Position = UDim2.fromScale(0.5, 0.32)
	})
	table.insert(activeTweens, tw1)
	tw1:Play()

	local targetColor = isRed and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(205, 170, 255)
	local tw2 = TweenService:Create(HeardText, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
		Rotation = rotDir, TextColor3 = targetColor
	})
	table.insert(activeTweens, tw2)
	tw2:Play()

	task.spawn(function()
		tw1.Completed:Wait()
		if currentId ~= textCounter then return end

		local tw3 = TweenService:Create(HeardText, TweenInfo.new(0.5, Enum.EasingStyle.Exponential, Enum.EasingDirection.In), {
			Position = UDim2.fromScale(0.5, 1.2)
		})
		table.insert(activeTweens, tw3)
		tw3:Play()
		tw3.Completed:Wait()

		if currentId == textCounter then
			HeardText.Visible = false
		end
	end)
end

