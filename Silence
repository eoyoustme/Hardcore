local Removed = false

RemoveSilence = function()
	if Removed then return end
	Removed = true
	Kill = false

	StopMonochromeTint()

	if thread then
		task.cancel(thread)
		thread = nil
	end

	if Silence5 and Silence5.Parent then
		Silence5:Destroy()
	end
end
