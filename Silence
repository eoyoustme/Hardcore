-- 7. CHU?I TRUY ÐU?I (TWEEN ÐU?I THEO PLAYER & D?NG KHI NÚP)
--------------------------------------------------------------------------------
local lastPos = HRP.Position
local damageInterval = 0.054
local thread = nil

local function StartChaseSequence()
	if isChasing then return end
	isChasing = true

	StartText(3)
	LaunchText(true)
	StartMonochromeTint(true)

	task.wait(3)

	local currentChaseTween = nil

	while Kill do
		task.wait(damageInterval)

		-- N?U PLAYER NÚP: D?ng Tween di chuy?n c?a Silence và m? Minigame
		if Character:GetAttribute("Hiding") then
			if currentChaseTween then
				currentChaseTween:Cancel()
				currentChaseTween = nil
			end
			
			if Silence and Silence.Parent then
				Silence.Anchored = true
			end

			if not inMinigame then
				StartHeartbeatMinigame()
			end
		end

		-- CH? ÐU?I THEO VÀ T?N CÔNG KHI KHÔNG TRONG MINIGAME VÀ KHÔNG NÚP
		if not inMinigame and not Character:GetAttribute("Hiding") then
			local currentPos = HRP.Position

			pcall(function()
				require(LocalPlayer.PlayerGui.MainUI.Initiator.Main_Game).caption("", true)
			end)

			if Humanoid.Health > 0 then
				Silence.Anchored = true

				-- Âm thanh du?i
				local s = Instance.new("Sound")
				s.SoundId = "rbxassetid://7861818231"
				s.Volume = 0.5
				s.Parent = workspace
				s:Play()
				Debris:AddItem(s, 2)

				-- T?c d? và Tween Silence d?n v? trí ngu?i choi
				local SPEED_STUDS_PER_SECOND = 28
				local targetCFrame = HRP.CFrame
				local distance = (targetCFrame.Position - Silence.Position).Magnitude
				local duration = distance / SPEED_STUDS_PER_SECOND

				if duration <= 0 then duration = 0.05 end

				currentChaseTween = TweenService:Create(
					Silence,
					TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut),
					{CFrame = targetCFrame}
				)
				currentChaseTween:Play()

				-- ÐI?U KI?N TIÊU DI?T: L?i g?n player (<= 9 studs) HO?C di chuy?n trong phòng mà không cúi
				local movedUncrouchedInRoom = IsPlayerInRoom(activeRoom) and not Character:GetAttribute("Crouching") and (currentPos - lastPos).Magnitude > 0.3
				
				if distance <= 9 or movedUncrouchedInRoom then
					Humanoid.Health = 0

					local sound = Instance.new("Sound")
					sound.SoundId = "rbxassetid://4988621968"
					sound.Volume = 10
					sound.PlaybackSpeed = 0.7
					sound.Parent = workspace
					sound:Play()
					Debris:AddItem(sound, 3)

					if RemoveSilence then RemoveSilence() end
					break
				end
			end
			lastPos = currentPos
		end
	end
end

-- THREAD PHÁT HI?N DI CHUY?N BAN Ð?U Ð? KÍCH HO?T CHASE
thread = task.spawn(function()
	while Kill and not isChasing do
		task.wait(0.1)
		local currentPos = HRP.Position
		if IsPlayerInRoom(activeRoom) and (currentPos - lastPos).Magnitude > 0.3 then
			StartChaseSequence()
			break
		end
		lastPos = currentPos
	end
end)

