local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local hrp = character:WaitForChild("HumanoidRootPart")
local camera = Workspace.CurrentCamera

local CONFIG = {
	UPTIME = 2,                    
	DAMAGE = 25,                
	SPAWN_OFFSET = 20,          
	DASH_TIME = 1,                
	HITBOX_RADIUS = 6,            
	END_FADE_TIME = 0.65,      

	MODEL_ID = "rbxassetid://90250291645240",
	END_SOUND_ID = "rbxassetid://91339787662755",
	FACE_TEXTURE = "rbxassetid://16026109489"
}

local function EndShocker(shockerModel, basePart)
	if not shockerModel or not shockerModel.Parent then return end

	local endSound = Instance.new("Sound")
	endSound.Name = "ShockerEnd"
	endSound.SoundId = CONFIG.END_SOUND_ID
	endSound.Volume = 1
	endSound.PlaybackSpeed = 1
	endSound.RollOffMinDistance = 10
	endSound.RollOffMaxDistance = 100
	endSound.RollOffMode = Enum.RollOffMode.InverseTapered
	endSound.Parent = basePart
	endSound:Play()

	local soundsToFade = {}
	local lightsToFade = {}

	for _, v in ipairs(shockerModel:GetDescendants()) do
		if v:IsA("ParticleEmitter") then
			v.Rate = 0
		elseif v:IsA("Light") then
			v.Enabled = true
			v.Range = 20
			v.Brightness = 5
			table.insert(lightsToFade, v)
		elseif v:IsA("Sound") and v.Playing then
			table.insert(soundsToFade, v)
		end
	end

	task.wait(0.01)
	if not shockerModel.Parent then return end

	local fadeInfo = TweenInfo.new(CONFIG.END_FADE_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

	for _, light in ipairs(lightsToFade) do
		if light.Parent then
			TweenService:Create(light, fadeInfo, {Range = 0, Brightness = 0}):Play()
		end
	end

	for _, sound in ipairs(soundsToFade) do
		if sound.Parent then
			TweenService:Create(sound, fadeInfo, {PlaybackSpeed = 0}):Play()
		end
	end

	task.wait(CONFIG.END_FADE_TIME)

	if shockerModel and shockerModel.Parent then
		for _, k in ipairs(shockerModel:GetDescendants()) do
			if k:IsA("Sound") then k:Stop()
			elseif k:IsA("Light") then k.Enabled = false
			elseif k:IsA("ParticleEmitter") then k.Enabled = false end
		end
		shockerModel:Destroy()
	end
end

local function spawnShocker()
	local success, objects = pcall(function()
		return game:GetObjects(CONFIG.MODEL_ID)
	end)

	if not success or not objects or #objects == 0 then
		return
	end

	local shockerModel = objects[1]
	local rootPart = shockerModel:FindFirstChild("HumanoidRootPart") or shockerModel:FindFirstChildWhichIsA("BasePart")
	shockerModel.PrimaryPart = rootPart
	shockerModel.Parent = Workspace

	local basePart = shockerModel:WaitForChild("Base", 5) or rootPart
	basePart.Anchored = true
	basePart.CanCollide = false
	basePart.CanTouch = false
	basePart.CanQuery = false

	local playSound = basePart:FindFirstChild("PlaySound") or Instance.new("Sound", basePart)
	playSound:Play()
	local horrorScream = basePart:FindFirstChild("HORROR SCREAM 15") or Instance.new("Sound", SoundService)
	local repentSound = basePart:FindFirstChild("Repent")
	repentSound:Destroy()

	local function GetGitSound(GithubSnd, SoundName)
		local url = GithubSnd
		if not isfile(SoundName .. ".mp3") then
			writefile(SoundName .. ".mp3", game:HttpGet(url))
		end
		local sound = Instance.new("Sound")
		sound.SoundId = (getcustomasset or getsynasset)(SoundName .. ".mp3")
		return sound
	end
	local Jumpscare = GetGitSound("https://github.com/eoyoustme/Pressure-Skid-Gay-/blob/main/virtual_vibes-electric-shock-404227.mp3?raw=true","yooowtf")
	Jumpscare.Volume = 1
	Jumpscare.PlaybackSpeed = 1
	Jumpscare.RollOffMinDistance = 10
	Jumpscare.RollOffMaxDistance = 100
	Jumpscare.RollOffMode = Enum.RollOffMode.InverseTapered
	Jumpscare.Parent = basePart

	playSound.PlaybackSpeed = 0.7
	playSound.Volume = 1
	playSound:Play()

	local pitchTween = TweenService:Create(playSound, TweenInfo.new(CONFIG.UPTIME, Enum.EasingStyle.Linear), {PlaybackSpeed = 2})
	pitchTween:Play()

	local lookDir = camera.CFrame.LookVector
	local flatLook = Vector3.new(lookDir.X, 0, lookDir.Z)
	flatLook = if flatLook.Magnitude >= 0.001 then flatLook.Unit else Vector3.new(0, 0, -1)
	local currentPos = hrp.Position + (flatLook * CONFIG.SPAWN_OFFSET)

	local elapsed = 0
	while elapsed < CONFIG.UPTIME do
		if not shockerModel.Parent or not character.Parent then
			pitchTween:Cancel()
			if shockerModel and shockerModel.Parent then shockerModel:Destroy() end
			return
		end

		if character:GetAttribute("Hiding") == true and character:GetAttribute("EquippedCharm") == "Accursed" then
			pitchTween:Cancel()
			shockerModel:Destroy()
			return
		end

		local dt = RunService.RenderStepped:Wait()
		elapsed = elapsed + dt

		local camLook = camera.CFrame.LookVector
		local camUnit = Vector3.new(camLook.X, 0, camLook.Z)
		camUnit = if camUnit.Magnitude >= 0.001 then camUnit.Unit else Vector3.new(0, 0, -1)

		local targetPos = hrp.Position + (camUnit * CONFIG.SPAWN_OFFSET)
		currentPos = currentPos:Lerp(targetPos, 1 - math.exp(-5 * dt))

		local faceDir = Vector3.new((hrp.Position - currentPos).X, 0, (hrp.Position - currentPos).Z)
		faceDir = if faceDir.Magnitude >= 0.001 then faceDir.Unit else Vector3.new(0, 0, -1)

		shockerModel:PivotTo(CFrame.lookAt(currentPos, currentPos + faceDir))
	end

	playSound.PlaybackSpeed = 2

	if character:GetAttribute("Hiding") == true then
		shockerModel:Destroy()
		return
	end

	if character:FindFirstChild("Crucifix") then
		pcall(function()
			ReplicatedStorage.HardcoreRemotes.ShockerDamage:FireServer(0, shockerModel:GetPivot())
		end)
		shockerModel:Destroy()
		return
	end

	local attachment = basePart:FindFirstChild("Attachment")
	local faces = attachment and attachment:FindFirstChild("Faces")
	if faces then
		for _, particle in ipairs(faces:GetChildren()) do
			if particle:IsA("ParticleEmitter") then
				particle.Texture = CONFIG.FACE_TEXTURE
				particle.Size = NumberSequence.new(3)
			end
		end
	end

	local playerPos = hrp.Position
	local shockerPos = shockerModel:GetPivot().Position

	local fromPlayerToShocker = (shockerPos - playerPos)
	local dirToShocker = Vector3.new(fromPlayerToShocker.X, 0, fromPlayerToShocker.Z)
	dirToShocker = if dirToShocker.Magnitude >= 0.001 then dirToShocker.Unit else Vector3.new(0, 0, -1)

	local startDashPos = playerPos + (dirToShocker * 20)
	local endDashPos = playerPos - (dirToShocker * 20)
	local moveDir = (endDashPos - startDashPos).Unit

	shockerModel:PivotTo(CFrame.lookAt(startDashPos, startDashPos + moveDir))

	-- ĐÃ SỬA: Thay attackSound thành Jumpscare
	Jumpscare.TimePosition = 0
	Jumpscare:Play()
	TweenService:Create(Jumpscare, TweenInfo.new(CONFIG.DASH_TIME, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {PlaybackSpeed = 0.7}):Play()

	horrorScream.Parent = SoundService
	horrorScream:Play()
	Debris:AddItem(horrorScream, math.max(horrorScream.TimeLength, 1) + 5)

	local dashProgress = 0
	local hasHit = false

	while dashProgress < CONFIG.DASH_TIME do
		if not shockerModel.Parent or not hrp.Parent then break end

		local dt = RunService.RenderStepped:Wait()
		dashProgress = dashProgress + dt

		local alpha = math.clamp(dashProgress / CONFIG.DASH_TIME, 0, 1)
		local easedAlpha = TweenService:GetValue(alpha, Enum.EasingStyle.Circular, Enum.EasingDirection.In)

		local currentDashPos = startDashPos:Lerp(endDashPos, easedAlpha)
		shockerModel:PivotTo(CFrame.lookAt(currentDashPos, currentDashPos + moveDir))

		if not hasHit and (basePart.Position - hrp.Position).Magnitude <= CONFIG.HITBOX_RADIUS then
			hasHit = true
			humanoid:TakeDamage(CONFIG.DAMAGE)

			pcall(function()
				ReplicatedStorage.GameStats["Player_".. player.Name].Total.DeathCause.Value = "Shocker"
				firesignal(ReplicatedStorage.RemotesFolder.DeathHint.OnClientEvent, {
					"You encountered Shocker...",
					"Dodge out of its path when it charges!"
				}, "Blue")
			end)
		end
	end

	EndShocker(shockerModel, basePart)

	pcall(function()
		local achievementGiver = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"))()
		achievementGiver({
			Title = "Shocking Experience",
			Desc = "Look at me.",
			Reason = "Encounter Shocker.",
			Image = "rbxassetid://17857830685"
		})
	end)
end

spawnShocker()
