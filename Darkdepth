task.spawn(function()
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- 1. TẠO GIAO DIỆN HÌNH ẢNH (UI EFFECT)
-- ==========================================
task.spawn(function()
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "Aihoi"
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 999999
	screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

	local imageLabel = Instance.new("ImageLabel")
	imageLabel.BackgroundTransparency = 1
	imageLabel.BorderSizePixel = 0
	imageLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	imageLabel.Position = UDim2.new(0.5, 0, 0.206, 0)
	imageLabel.Size = UDim2.new(0, 300, 0, 300)
	imageLabel.ScaleType = Enum.ScaleType.Stretch
	imageLabel.ImageTransparency = 1
	imageLabel.Image = "rbxassetid://97049603586965"
	imageLabel.Visible = true
	imageLabel.Parent = screenGui

	-- Hiện hình ảnh
	TweenService:Create(imageLabel, TweenInfo.new(1), {ImageTransparency = 0}):Play()
	task.wait(14)

	-- Ẩn hình ảnh và hủy UI
	TweenService:Create(imageLabel, TweenInfo.new(1), {ImageTransparency = 1}):Play()
	task.wait(1)
	screenGui:Destroy()
end)

local function shatterRoomLights(targetFolder)
	targetFolder = targetFolder or workspace

	-- 1. Cho đèn nhấp nháy trước khi vỡ
	for i = 1, 8 do
		Lighting.Brightness = math.random(-2, 1)
		task.wait(math.random(3, 10) / 1000)
	end

	-- 2. Tối đen Lighting
	TweenService:Create(Lighting, TweenInfo.new(0.5), {
		Ambient = Color3.new(0, 0, 0),
		Brightness = -2,
		FogStart = 20,
		FogEnd = 50,
		FogColor = Color3.new(0, 0, 0)
	}):Play()

	-- 3. Phát âm thanh vỡ bóng đèn
	local glassBreakSound = Instance.new("Sound")
	glassBreakSound.SoundId = "rbxassetid://9114223179"
	glassBreakSound.Volume = 2.5
	glassBreakSound.PlaybackSpeed = math.random(90, 110) / 100
	glassBreakSound.Parent = workspace
	glassBreakSound:Play()
	Debris:AddItem(glassBreakSound, 3)

	-- 4. Tắt toàn bộ nguồn sáng trong phòng
	for _, obj in ipairs(targetFolder:GetDescendants()) do
		if obj:IsA("Light") then
			obj.Enabled = false
		end
		if obj:IsA("BasePart") and obj.Material == Enum.Material.Neon then
			obj.Material = Enum.Material.SmoothPlastic
			obj.Color = Color3.fromRGB(7, 7, 7)
		end
	end
end

-- Lắng nghe sự kiện mở phòng mới
task.spawn(function()
	local gameData = ReplicatedStorage:WaitForChild("GameData", 15)
	if gameData then
		local latestRoom = gameData:WaitForChild("LatestRoom", 15)
		if latestRoom then
			latestRoom.Changed:Connect(function(roomNumber)
				local currentRooms = workspace:FindFirstChild("CurrentRooms")
				local roomModel = currentRooms and currentRooms:FindFirstChild(tostring(roomNumber))
				shatterRoomLights(roomModel or workspace)
			end)
		end
	end
end)

