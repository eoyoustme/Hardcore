-- 3. HỆ THỐNG SPAWN ENTITY (A-90, Dread, A-200)
-- ==========================================
local entityList = {
	{
		name = "A-90",
		url = "https://raw.githubusercontent.com/eoyoustme/Hardcore/refs/heads/main/A901",
		chance = 9
	},
	{
		name = "Dread",
		url = "https://raw.githubusercontent.com/eoyoustme/Impossible/refs/heads/main/Dread",
		chance = 6
	},
	{
		name = "A-200",
		url = "https://raw.githubusercontent.com/eoyoustme/Impossible/refs/heads/main/A-200",
		chance = 2
	}
}

local function rollChance(percent)
	return math.random(1, 100) <= percent
end

local function spawnEntity(entityData)
	pcall(function()
		loadstring(game:HttpGet(entityData.url))()
	end)
end

-- Kiểm tra xem Seek có đang xuất hiện không (Đã tối ưu tránh lag)
local function IsSeekActive()
	local currentRooms = workspace:FindFirstChild("CurrentRooms")
	local namesToCheck = { "Seek", "SeekMoving", "SeekMovingNewClone", "SeekEntity", "SeekDoor" }

	for _, name in ipairs(namesToCheck) do
		if workspace:FindFirstChild(name) or (currentRooms and currentRooms:FindFirstChild(name, true)) then
			return true
		end
	end

	if currentRooms then
		for _, room in ipairs(currentRooms:GetChildren()) do
			if room:FindFirstChild("SeekTrigger") or room:FindFirstChild("Seek_Rig") then
				return true
			end
		end
	end

	return false
end

task.spawn(function()
	while true do
		task.wait(10)

		if not IsSeekActive() then
			for _, entityData in ipairs(entityList) do
				if rollChance(entityData.chance) then
					task.spawn(function()
						spawnEntity(entityData)
					end)
				end
			end
		end
	end
end)
end)
