
local function GetCustomAsset(url, filename)
	local filePath = filename .. ".mp3"
	if not isfile(filePath) then
		writefile(filePath, game:HttpGet(url))
	end
	return (getcustomasset or getsynasset)(filePath)
end

local function fixSeek(figure: Model)
	local parent = figure.Parent
	if not parent then return end

	local origMusic = parent:WaitForChild("SeekMusic")

	origMusic.Volume = 0

	local newerMusic = origMusic:Clone()
	newerMusic.Name = "SeekMusicCustom"
	newerMusic.Volume = 1
	newerMusic.Parent = parent

	task.spawn(function()
		local soundAsset = GetCustomAsset("https://github.com/eoyoustme/Impossible/blob/main/SeekMusic.mp3?raw=true", "SeekMusic")
		newerMusic.SoundId = soundAsset
	end)

	origMusic:GetPropertyChangedSignal("Playing"):Connect(function()
		if origMusic.Playing then
			if not newerMusic.Playing then
				newerMusic.TimePosition = 2
				newerMusic:Play()
			end
		else
			newerMusic:Stop()
		end
	end)
end
