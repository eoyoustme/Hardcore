local function GetGitSound(GithubSnd, SoundName)
	local url = GithubSnd

	if not isfile(SoundName .. ".mp3") then
		writefile(SoundName .. ".mp3", game:HttpGet(url))
	end

	local sound = Instance.new("Sound")
	sound.SoundId = (getcustomasset or getsynasset)(SoundName .. ".mp3")
	return sound
end

local anhlabacsido = GetGitSound("https://github.com/eoyoustme/Hardcore/blob/main/SeekMoving.mp3?raw=true","Seek")

local targets = {game:GetService("ReplicatedStorage"), workspace, game:GetService("Players").LocalPlayer}
for _, parent in ipairs(targets) do
	if parent then
		for _, desc in ipairs(parent:GetDescendants()) do
			if desc:IsA("Sound") and desc.Name == "SeekMusic" then
				if desc.SoundId ~= anhlabacsido then
					desc.SoundId = anhlabacsido
					if desc.IsPlaying then
						desc:Stop()
						desc:Play()
					end
				end
			end
		end
	end
end
