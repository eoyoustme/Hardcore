local function normalfadeSounds(duration)
	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local sounds = {}

	if s:IsA("Sound") then table.insert(sounds, s) end
	for _, desc in ipairs(s:GetDescendants()) do
		if desc:IsA("Sound") then table.insert(sounds, desc) end
	end

	for _, sound in ipairs(sounds) do
		local originalSpeed = sound:GetAttribute("OriginalSpeed") or 1

		TweenService:Create(sound, tweenInfo, {PlaybackSpeed = originalSpeed}):Play()

		task.delay(duration, function()
			if sound and sound.Parent then
				sound.PlaybackSpeed = originalSpeed
			end
		end)
	end
end

