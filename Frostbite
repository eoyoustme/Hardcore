local function GetRoom()
	local rooms = workspace:FindFirstChild("CurrentRooms")
	if rooms and latestRoom.Value then
		return rooms:FindFirstChild(tostring(latestRoom.Value))
	end
	return nil
end

-- 📥 Tải Model 1 lần duy nhất ở ngoài vòng lặp
local modelTemplate = GetGithubModel("https://raw.githubusercontent.com/eoyoustme/Hardcore/refs/heads/main/Frostbite.rbxm")
if not modelTemplate then
	warn("[Frostbite]: Không thể khởi tạo Model, đã dừng script.")
	return
end

-- 🔁 Vòng lặp 8 đợt tấn công
for i = 1, 8 do
	local currentRoom = GetRoom()
	if not currentRoom then break end

	local camera = workspace.CurrentCamera
	local s = modelTemplate:Clone()
	s.Parent = workspace
	s.Name = "Frostyma5n"

	local entity = s:FindFirstChildWhichIsA("BasePart") or s.PrimaryPart or s:FindFirstChild("FrostyNew")
	if not entity then
		s:Destroy()
		break
	end

	entity.CanCollide = false

	local entrance = currentRoom:FindFirstChild("RoomEntrance")
	if entrance then
		entity.CFrame = entrance.CFrame * CFrame.new(0, 10, -30)
	end

	-- Tắt Particle ban đầu
	local attachment = entity:FindFirstChild("Attachment")
	if attachment then
		for _, v in ipairs(attachment:GetDescendants()) do
			if v:IsA("ParticleEmitter") then
				v.Enabled = false
			end
		end
	end

	task.wait(0.5)

	camera.CameraType = Enum.CameraType.Custom

	-- Rung camera
	local isShaking = true

	threadA = task.spawn(function()
		while isShaking do
			task.wait(0.1)

			local CameraShaker = game.ReplicatedStorage:FindFirstChild("CameraShaker") or (game.ReplicatedStorage:FindFirstChild("Modules") and game.ReplicatedStorage.Modules:FindFirstChild("CameraShaker"))
			if CameraShaker then
				local CameraShakerModule = require(CameraShaker)
				local camShake = CameraShakerModule.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
					camera.CFrame = camera.CFrame * shakeCf
				end)
				camShake:Start()
				camShake:ShakeOnce(10, 10, 0.5, 0.1, 2, 0.5)
			end
		end
	end)

	-- Bật Particle
	if attachment then
		for _, v in ipairs(attachment:GetDescendants()) do
			if v:IsA("ParticleEmitter") then
				v.Enabled = true
			end
		end
	end

	local attacking = true

	local roomConnection
	roomConnection = workspace.CurrentRooms.ChildAdded:Connect(function()
		if not attacking then return end
		attacking = false

		if roomConnection then
			roomConnection:Disconnect()
		end

		if s and s.Parent then
			s:Destroy()
		end
	end)

	-- Luồng gây sát thương & hiệu ứng màn hình
	task.spawn(function()
		local Players = game:GetService("Players")
		local Lighting = game:GetService("Lighting")
		local player = Players.LocalPlayer

		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "Aihoi"
		screenGui.IgnoreGuiInset = true
		screenGui.DisplayOrder = 999999
		screenGui.Parent = player:WaitForChild("PlayerGui")

		local imageLabel = Instance.new("ImageLabel")
		imageLabel.BackgroundTransparency = 1
		imageLabel.BorderSizePixel = 0
		imageLabel.Position = UDim2.new(0, 0, 0, 0)
		imageLabel.Size = UDim2.new(1, 0, 1, 0)
		imageLabel.ScaleType = Enum.ScaleType.Stretch
		imageLabel.Image = "rbxassetid://10344339712"
		imageLabel.ImageTransparency = 0
		imageLabel.Visible = true
		imageLabel.Parent = screenGui

		local blur = Lighting:FindFirstChild("Blur5")
		if not blur then
			blur = Instance.new("BlurEffect")
			blur.Name = "Blur5"
			blur.Size = 10
			blur.Parent = Lighting
		else
			blur.Enabled = true
		end

local damage = 2

		while attacking and entity and entity.Parent do
			task.wait(1)

			local character = player.Character
			if not character then continue end

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health <= 0 then 
				break
			end

			local lighter = character:FindFirstChild("Lighter")

			if not lighter or not lighter:GetAttribute("Enabled") then
				imageLabel.ImageTransparency = 0
				blur.Enabled = true

				pcall(function()
					humanoid.Health = math.max(0, humanoid.Health - damage)

					local statsFolder = game.ReplicatedStorage:FindFirstChild("GameStats")
					if statsFolder then
						local playerStats = statsFolder:FindFirstChild("Player_" .. player.Name)
						if playerStats and playerStats:FindFirstChild("Total") and playerStats.Total:FindFirstChild("DeathCause") then
							playerStats.Total.DeathCause.Value = "Frostbite"
						end
					end
					task.spawn(function()
						while true do
							task.wait(1)
							damage = math.max(0, damage + 0.3)
						end
					end)
				end)
			else
				imageLabel.ImageTransparency = 1
				if blur then
					blur.Enabled = false
				end
			end
		end
	end)

	-- Chờ lượt tấn công kết thúc
	repeat
		task.wait(0.1)
	until not attacking
end

isShaking = false
if threadA then
	task.cancel(threadA)
	threadA = nil
end


