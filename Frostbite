-- 🔊 Hàm tải âm thanh an toàn
local function GetGitSound(GithubSnd, SoundName)
	local fileName = SoundName .. ".mp3"
	if not isfile(fileName) then
		local success, response = pcall(function()
			return game:HttpGet(GithubSnd)
		end)
		if success and response then
			writefile(fileName, response)
		else
			warn("[Frostbite]: Không thể tải âm thanh!")
			return nil
		end
	end

	local sound = Instance.new("Sound")
	sound.SoundId = getasset(fileName)
	return sound
end

-- 📦 Hàm tải Model từ GitHub
local function GetGithubModel(url)
	local fileName = string.match(url, "([^/]+)$") or "temp_model.rbxm"

	if not isfile(fileName) then
		local response = http_request({Url = url, Method = "GET"})
		if response and response.StatusCode == 200 then
			writefile(fileName, response.Body)
		else
			warn("[Frostbite]: Không thể tải Model từ GitHub!")
			return nil
		end
	end

	local assetId = getasset(fileName)
	local success, result = pcall(function() 
		return game:GetObjects(assetId)[1] 
	end)

	return success and result or nil
end

