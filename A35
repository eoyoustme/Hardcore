---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
	print("Entity has spawned")
	local root = game.Workspace.A35.RushNew
	local face = root.MonsterGui
	local image = face.Image1
	local pos_x = 1
	local pos_y = 1
	local pos_z = 1
	local rot = 45

task.spawn(function()
	while true do
		wait()
		face.ExtentsOffsetWorldSpace = Vector3.new(Random.new():NextNumber(-pos_x,pos_x),Random.new():NextNumber(-pos_y,pos_y),Random.new():NextNumber(-pos_z,pos_z))
		image.Rotation = math.random(-rot,rot)
		end
	end)
	
	while true do
		game.Workspace.A35.RushNew.MonsterGui.Image1 = "rbxassetid://15822684662"
		wait(0.4)
		game.Workspace.A35.RushNew.MonsterGui.Image1 = "rbxassetid://13337970056"
		wait(0.4)
	end
	
end)

entity:SetCallback("OnStartMoving", function()
	print("Entity has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
	if firstTime == true then
		print("Entity has entered room: ".. room.Name.. " for the first time")
	else
		print("Entity has entered room: ".. room.Name.. " again")
	end
end)

entity:SetCallback("OnLookAt", function(lineOfSight)
	if lineOfSight == true then
		print("Player is looking at entity")
	else
		print("Player view is obstructed by something")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
	if startOfRebound == true then
		print("Entity has started rebounding")
	else
		print("Entity has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
	print("Entity is despawning")
end)

entity:SetCallback("OnDespawned", function()
	print("Entity has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth)
	if newHealth == 0 then
		print("Entity has killed the player")
		local Players = game:GetService("Players")
		local TweenService = game:GetService("TweenService")

		local player = Players.LocalPlayer
		local playerGui = player:WaitForChild("PlayerGui")
		local rng = Random.new()

		local screenGui = Instance.new("ScreenGui")
		screenGui.Name = "JumpscareGui"
		screenGui.ResetOnSpawn = false
		screenGui.IgnoreGuiInset = true
		screenGui.DisplayOrder = 999999
		screenGui.Parent = playerGui

		-- Tạo background
		local background = Instance.new("Frame")
		background.Name = "Background"
		background.Size = UDim2.fromScale(1, 1)
		background.Position = UDim2.fromScale(0, 0)
		background.BackgroundColor3 = Color3.new(0, 0, 0)
		background.BorderSizePixel = 0
		background.Parent = screenGui

		-- Tạo ImageLabel
		local imageLabel = Instance.new("ImageLabel")
		imageLabel.Name = "ImageLabel"
		imageLabel.BackgroundTransparency = 1
		imageLabel.AnchorPoint = Vector2.new(0.5, 0.5)
		imageLabel.Position = UDim2.fromScale(0.5, 0.5)
		imageLabel.Size = UDim2.new(0.25, 0,0.3, 0)
		imageLabel.Image = "rbxassetid://11218646640"
		imageLabel.Parent = background

		task.spawn(function()
			while true do
				imageLabel.Image = "rbxassetid://11218346472"
				wait(0.2)
				imageLabel.Image = "rbxassetid://11218646640"
				wait(0.2)
			end
		end)

		-- Tạo Sound
		local jumpscareSound = Instance.new("Sound")
		jumpscareSound.Name = "Jumpscare"
		jumpscareSound.SoundId = "rbxassetid://127039440804189"
		jumpscareSound.Volume = 5
		jumpscareSound.PlaybackSpeed = 0.75
		jumpscareSound.Parent = workspace
		jumpscareSound:Play()

		local dis = Instance.new("DistortionSoundEffect")
		dis.Level = 1
		dis.Enabled = true
		dis.Parent = jumpscareSound

		local pitch = Instance.new("PitchShiftSoundEffect")
		pitch.Octave = 0.98
		pitch.Enabled = true
		pitch.Parent = jumpscareSound

		local fullTween = TweenService:Create(
			imageLabel,
			TweenInfo.new(0.4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
			{
				Size = UDim2.new(0, 1050, 0, 1050)
			}
		)

		fullTween:Play()

		for i = 1,Random.new():NextInteger(40,80) do
			local mode = rng:NextInteger(1, 3)

			if mode == 1 then
				background.BackgroundColor3 = Color3.new(0, 0, 0)
				imageLabel.ImageColor3 = Color3.new(1, 1, 1)
			elseif mode == 2 then
				background.BackgroundColor3 = Color3.new(0, 1, 0)
				imageLabel.ImageColor3 = Color3.new(0, 0, 0)
			else
				background.BackgroundColor3 = Color3.new(0, 0.333333, 0)
				imageLabel.ImageColor3 = Color3.new(0, 0.666667, 0)
			end
			imageLabel.Position = UDim2.new(rng:NextNumber(0.2, 0.8), 0, rng:NextNumber(0.2, 0.8), 0)
			imageLabel.Rotation = rng:NextInteger(-30, 30)
			task.wait(Random.new():NextInteger(0.01,0.02))
		end


		local Sizle = TweenService:Create(
			imageLabel,
			TweenInfo.new(Random.new():NextInteger(0.2,0.1), Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
			{
				Size = UDim2.new(0, 350, 0, 350)
			}
		)

		Sizle:Play()

		for i = 1,Random.new():NextInteger(20,10) do
			local cac = rng:NextInteger(1, 3)

			if cac == 1 then
				background.BackgroundColor3 = Color3.new(0, 0, 0)
				imageLabel.ImageColor3 = Color3.new(1, 1, 1)
			elseif cac == 2 then
				background.BackgroundColor3 = Color3.new(0, 1, 0)
				imageLabel.ImageColor3 = Color3.new(0, 0, 0)
			else
				background.BackgroundColor3 = Color3.new(0, 0.333333, 0)
				imageLabel.ImageColor3 = Color3.new(0, 0.666667, 0)
			end
			imageLabel.Position = UDim2.new(rng:NextNumber(0.2, 0.8), 0, rng:NextNumber(0.2, 0.8), 0)
			imageLabel.Rotation = rng:NextInteger(-10, 10)
			task.wait(0)
		end

		local Coi = TweenService:Create(
			imageLabel,
			TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{
				Size = UDim2.new(0, 2550, 0, 2550)
			}
		)

		Coi:Play()

		for i = 1, Random.new():NextInteger(40,80) do
			local aihoi = rng:NextInteger(1, 3)

			if aihoi == 1 then
				background.BackgroundColor3 = Color3.new(0, 0, 0)
				imageLabel.ImageColor3 = Color3.new(1, 1, 1)
			elseif aihoi == 2 then
				background.BackgroundColor3 = Color3.new(0, 1, 0)
				imageLabel.ImageColor3 = Color3.new(0, 0, 0)
			else
				background.BackgroundColor3 = Color3.new(0, 0.333333, 0)
				imageLabel.ImageColor3 = Color3.new(0, 0.666667, 0)
			end
			imageLabel.Position = UDim2.new(rng:NextNumber(0.2, 0.8), 0, rng:NextNumber(0.2, 0.8), 0)
			imageLabel.Rotation = rng:NextInteger(-10, 10)
			task.wait(Random.new():NextInteger(0.01 , 0.02))
		end


		screenGui:Destroy()
		imageLabel:Destroy()
		background:Destroy()
	else
		print("Entity has damaged the player")
	end
end)

