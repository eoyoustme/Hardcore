local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")

local function GetRoom()
	local currentRooms = workspace:FindFirstChild("CurrentRooms")
	if not currentRooms then return nil end

	local gameData = game.ReplicatedStorage:FindFirstChild("GameData")
	local latestRoom = gameData and gameData:FindFirstChild("LatestRoom")

	if latestRoom then
		return currentRooms:FindFirstChild(tostring(latestRoom.Value))
	end
	return nil
end

-- Tải Asset an toàn
local success, assets = pcall(function()
	return game:GetObjects("rbxassetid://134261174233456")
end)

if not success or not assets or #assets == 0 then
	warn("⚠️ Không thể tải được Asset! Kiểm tra lại ID hoặc Executor.")
	return
end

local s = assets[1]
s.Name = "Singularity"
s.Parent = workspace

local entity = s:FindFirstChild("Singu") or s
if not entity then
	warn("⚠️ Không tìm thấy 'Singu' trong Asset!")
	s:Destroy()
	return
end

local room = GetRoom()
if not room then
	warn("⚠️ Không tìm thấy phòng hiện tại!")
	s:Destroy()
	return
end

-- Tìm vị trí Wardrobe.Main
local assetsFolder = room:WaitForChild("Assets", 5)
local wardrobe = assetsFolder and assetsFolder:WaitForChild("Wardrobe", 5)
local wardrobeMain = wardrobe and wardrobe:WaitForChild("Main", 5)

if not wardrobeMain then
	warn("⚠️ Không tìm thấy vị trí 'Assets.Wardrobe.Main'!")
	s:Destroy()
	return
end

-- Dịch chuyển Entity đến tủ
local spawnCFrame = wardrobeMain.CFrame
if entity:IsA("Model") then
	entity:PivotTo(spawnCFrame)
else
	entity.CFrame = spawnCFrame
end

-- Hàm phát âm thanh
local function playSound(soundName)
	local sound = entity:FindFirstChild(soundName, true) or s:FindFirstChild(soundName, true)
	if sound and sound:IsA("Sound") then
		sound:Play()
	end
end

local player = Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid", 5)
local hrp = char:WaitForChild("HumanoidRootPart", 5)
local camera = workspace.CurrentCamera

if not hrp or not hum then
	warn("⚠️ Không tìm thấy nhân vật!")
	s:Destroy()
	return
end

-- HÀM TẠO CHỮ ĐỎ THƯỜNG
local function createRedGlitchText(textString)
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then return end

	local sg = Instance.new("ScreenGui")
	sg.Name = "SingularityTextEffect"
	sg.ResetOnSpawn = false
	sg.Parent = playerGui

	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.new(1, 0, 0.25, 0)
	txt.Position = UDim2.new(0, 0, 0.38, 0)
	txt.BackgroundTransparency = 1
	txt.Text = textString or "INSERT YOUR FLASHING TEXT HERE"
	txt.TextColor3 = Color3.fromRGB(255, 255, 255)
	txt.TextStrokeColor3 = Color3.fromRGB(80, 0, 0)
	txt.TextStrokeTransparency = 0
	txt.TextScaled = true
	txt.Font = Enum.Font.SourceSansBold
	txt.Parent = sg

	task.spawn(function()
		for i = 1, 15 do
			txt.Position = UDim2.new(0, math.random(-8, 8), 0.38, math.random(-4, 4))
			txt.TextTransparency = math.random(0, 2) / 10
			task.wait(0.04)
		end
		txt.Position = UDim2.new(0, 0, 0.38, 0)
		txt.TextTransparency = 0
	end)

	Debris:AddItem(sg, 2.5)
end

-- VÒNG LẶP KIỂM TRA MỞ CỬA TỦ
while true do
	if not hrp or not hrp.Parent or not entity or not entity.Parent or not wardrobe or not wardrobe.Parent then
		s:Destroy()
		return
	end

	if wardrobe:GetAttribute("IsOpen") == true then
		break
	end

	task.wait(0.05)
end

-- XÓA PROMPT NÚP
local hidePrompt = wardrobe:FindFirstChild("HidePrompt", true)
local hidePromptHold = wardrobe:FindFirstChild("HidePromptHold", true)
if hidePrompt then hidePrompt:Destroy() end
if hidePromptHold then hidePromptHold:Destroy() end

-- KÍCH HOẠT CHẾ ĐỘ TẤN CÔNG
playSound("Scare")
playSound("caught")
playSound("ScreamingInPublicBathroomsPrank")

local function resetSoundTime(soundName)
	local snd = entity:FindFirstChild(soundName, true) or s:FindFirstChild(soundName, true)
	if snd and snd:IsA("Sound") then
		snd.TimePosition = 0
	end
end

resetSoundTime("caught")
resetSoundTime("Scare")
resetSoundTime("ScreamingInPublicBathroomsPrank")

task.wait(1.5)

if hum and hrp and entity and entity.Parent then
	local entityPos = entity:IsA("Model") and entity:GetPivot().Position or entity.Position
	local targetCFrame = entity:IsA("Model") and entity:GetPivot() or entity.CFrame

	local targets = {}
	local processedModels = {}
	local processedParts = {}

	local playerDistance = (hrp.Position - entityPos).Magnitude

	-- CHỈ XUẤT HIỆN CHỮ ĐỎ NEU TRONG VÙNG 25 STUDS
	if playerDistance <= 25 then
		createRedGlitchText("")
	end

	-- 1. QUÉT PLAYER TRONG BÁN KÍNH 35 STUDS
	if playerDistance <= 35 then
		table.insert(targets, {
			instance = hrp,
			distance = playerDistance,
			isModel = false,
			isPlayer = true
		})
	end

	-- 2. QUÉT ĐỒ VẬT XUNG QUANH
	local overlapParams = OverlapParams.new()
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
	overlapParams.FilterDescendantsInstances = {s, char}

	local nearbyParts = workspace:GetPartBoundsInRadius(entityPos, 60, overlapParams)

	for _, part in ipairs(nearbyParts) do
		local nameLower = string.lower(part.Name)
		if nameLower:find("floor") or nameLower:find("wall") or nameLower:find("keyhitbox") or nameLower:find("door") or part.Locked then
			continue
		end

		local parent = part.Parent
		if parent and parent:IsA("Model") and parent ~= workspace then
			if not processedModels[parent] then
				processedModels[parent] = true
				local modelPos = parent:GetPivot().Position
				local dist = (modelPos - entityPos).Magnitude
				table.insert(targets, {instance = parent, distance = dist, isModel = true, isPlayer = false})
			end
		else
			if not processedParts[part] then
				processedParts[part] = true
				local dist = (part.Position - entityPos).Magnitude
				table.insert(targets, {instance = part, distance = dist, isModel = false, isPlayer = false})
			end
		end
	end

	table.sort(targets, function(a, b) return a.distance < b.distance end)

	local maxPull = math.min(#targets, 6)
	local instancesToDestroy = {}

	local chainStart1 = entity:FindFirstChild("ChainStart1", true) or s:FindFirstChild("ChainStart1", true)
	local chainStart2 = entity:FindFirstChild("ChainStart2", true) or s:FindFirstChild("ChainStart2", true)

	local templateChains = {}
	if chainStart1 and chainStart1:FindFirstChild("SingularityChain") then
		table.insert(templateChains, {origin = chainStart1, beam = chainStart1.SingularityChain})
	end
	if chainStart2 and chainStart2:FindFirstChild("SingularityChain") then
		table.insert(templateChains, {origin = chainStart2, beam = chainStart2.SingularityChain})
	end

	local createdBeams = {}
	local createdAttachments = {}
	local playerChained = false

	-- 3. BẮN MỖI DÂY XÍCH CÁCH NHAU 0.5 GIÂY
	for i = 1, maxPull do
		local target = targets[i]
		local targetPart = nil

		if target.isPlayer then
			playerChained = true
			targetPart = target.instance
			targetPart.Anchored = true
		elseif target.isModel then
			targetPart = target.instance.PrimaryPart or target.instance:FindFirstChildWhichIsA("BasePart", true)
			table.insert(instancesToDestroy, target.instance)
		else
			targetPart = target.instance
			table.insert(instancesToDestroy, target.instance)
		end

		if targetPart and #templateChains > 0 then
			local targetAtt = Instance.new("Attachment")
			targetAtt.Name = "SingularityChainTargetAtt"
			targetAtt.Parent = targetPart
			table.insert(createdAttachments, targetAtt)

			local template = templateChains[((i - 1) % #templateChains) + 1]
			local originAtt = template.origin:IsA("Attachment") and template.origin or template.origin:FindFirstChildWhichIsA("Attachment")

			if not originAtt then
				originAtt = Instance.new("Attachment")
				originAtt.Name = "SingularityChainOriginAtt"
				originAtt.Parent = template.origin
				table.insert(createdAttachments, originAtt)
			end

			local beamToUse
			if i <= #templateChains then
				beamToUse = template.beam
			else
				beamToUse = template.beam:Clone()
				beamToUse.Parent = template.origin
				table.insert(createdBeams, beamToUse)
			end

			beamToUse.Attachment0 = originAtt
			beamToUse.Attachment1 = targetAtt
			beamToUse.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
			beamToUse.LightEmission = 1
			beamToUse.LightInfluence = 0
			beamToUse.Width0 = 1.2
			beamToUse.Width1 = 1.2
			beamToUse.Transparency = NumberSequence.new(0)
			beamToUse.Enabled = true

			playSound("Chained")
		end

		task.wait(0.5) -- Đổi thời gian bắn mỗi dây xích thành 0.5 giây
	end

	task.wait(0.3)

	-- 4. KHÓA CAMERA VÀ TWEEN KÉO ĐƠN GIẢN VỀ TỦ

	-- Tween kéo mượt mà trong 0.6s
	local pullTweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

	for i = 1, maxPull do
		local target = targets[i]
		if target.isPlayer then
			local pullCFrame = targetCFrame * CFrame.new(0, 0, -1)
			TweenService:Create(hrp, pullTweenInfo, {CFrame = pullCFrame}):Play()
		elseif target.isModel then
			for _, p in ipairs(target.instance:GetDescendants()) do
				if p:IsA("BasePart") then
					p.Anchored = true
					p.CanCollide = false
					TweenService:Create(p, pullTweenInfo, {CFrame = targetCFrame}):Play()
				end
			end
		else
			target.instance.Anchored = true
			target.instance.CanCollide = false
			TweenService:Create(target.instance, pullTweenInfo, {CFrame = targetCFrame}):Play()
		end
	end

	task.wait(0.6) -- Chờ Tween hoàn tất

	-- 5. TRỪ MÁU VÀ DỌN DẸP
	if playerChained and hum then
		hum.Health -= 60
	end

	for _, beam in ipairs(createdBeams) do if beam then beam:Destroy() end end
	for _, att in ipairs(createdAttachments) do if att then att:Destroy() end end
	for _, inst in ipairs(instancesToDestroy) do if inst then inst:Destroy() end end

	if playerChained and hrp then
		hrp.Anchored = false
	end

	-- MÀN HÌNH ĐỎ ĐẬM
	local cc = Instance.new("ColorCorrectionEffect", game.Lighting)
	Debris:AddItem(cc, 8)
	cc.Name = "Warn"
	cc.TintColor = Color3.fromRGB(255, 20, 20)
	cc.Saturation = -0.5
	cc.Contrast = 0.5

	TweenService:Create(cc, TweenInfo.new(5), {TintColor = Color3.fromRGB(255, 255, 255), Saturation = 0, Contrast = 0}):Play()

	local CameraShaker = require(game.ReplicatedStorage:WaitForChild("CameraShaker", 2))
	if CameraShaker and camera then
		local camShake = CameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
			camera.CFrame = camera.CFrame * shakeCf
		end)
		camShake:Start()
		camShake:ShakeOnce(35, 8, 0.05, 1.2)
	end

	playSound("bloood")
	playSound("gore0")
	playSound("gore1")
	playSound("gore2")
	playSound("gore3")

	local blood = entity:FindFirstChild("Blood", true) or s:FindFirstChild("Blood", true)
	if blood and blood:IsA("ParticleEmitter") then
		blood.Enabled = true
		task.wait(0.9)
		blood.Enabled = false
	end
end

task.wait(2)
if s and s.Parent then
	s:Destroy()
end
